  <title>01</title>
  <intro>&lt;h3&gt;Karel na muriku&lt;/h3&gt;&lt;p&gt;Karel stojí na &lt;b&gt;muriku z tehál&lt;/b&gt;. Napíš program, aby &lt;b&gt;prešiel celý murik&lt;/b&gt; a nespadol dole!&lt;/p&gt;&lt;p&gt;Pohni ho príkazom &lt;code&gt;dopredu&lt;/code&gt;, na konci sa otoč.&lt;/p&gt;</intro>
  <success>&lt;h3 style=&quot;color:#44ff88&quot;&gt;Výborne! 🎉&lt;/h3&gt;&lt;p&gt;Zvládol si prejsť celý murik. Skvelá práca!&lt;/p&gt;</success>
  <failure>&lt;h3 style=&quot;color:#ff6666&quot;&gt;Auuu…&lt;/h3&gt;&lt;p&gt;Karel spadol z murika. Skús to znova — pozor na okraj!&lt;/p&gt;</failure>
  <program>Zacatok
 
Koniec</program>
  <mission>
    <condition check="karel_pos" eval="failure" when="on_step" op="or" negate="true" z="1"/>
    <condition check="karel_pos" eval="success" when="on_finish" op="or" z="1"/>
  </mission>
</world>
